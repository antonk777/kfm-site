# Copy to /etc/kfm-site.env (chmod 600). Used by deploy.sh / systemd sync.
SITE_DOMAIN=kfm.manul.lol
SITE_ROOT=/var/www/kfm.manul.lol
SITE_LOG=/var/log/caddy/kfm.manul.lol.log
SITE_IP=85.192.30.108
CADDY_EMAIL=admin@manul.lol
COMPANION_GITHUB_TOKEN=ghp_replace_me
COMPANION_REPO=antonk777/KFMLauncher

# Unlisted /statistics/ dashboard (MariaDB = same as perkhost via .kfm-save.env)
STATS_HOST=127.0.0.1
STATS_PORT=8765
STATS_DAYS=180
# Password for /statistics + admin (restart / map / logs). Required.
STATS_ADMIN_PASSWORD=change-me
# Optional extra HMAC secret for auth cookies (defaults to hash of password).
# Also signs the public Steam login cookie when set.
# STATS_ADMIN_SECRET=
# Public origin for the header Steam login (OpenID realm + return URL).
# SITE_PUBLIC_URL=https://kf-maniacs.com
# Steam Web API key (steamcommunity.com/dev/apikey): the landing page shows
# whether each server is in the Steam browser list. One request per 10 min.
# STEAM_WEB_API_KEY=
# Discord card on the landing page: invite code behind it (default MJXsav9DFC,
# empty = no polling). Members online / in total come from the public invite;
# names and avatars need the server widget on (Server Settings -> Widget).
# DISCORD_INVITE=MJXsav9DFC
