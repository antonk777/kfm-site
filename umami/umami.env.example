# Generated on the server as /etc/kfm-umami.env (mode 600) the first time
# umami/up.sh runs. Do not commit a filled-in copy.
#
# Changing POSTGRES_PASSWORD after the first start does not alter the password
# already stored in the umami-db-data volume.
POSTGRES_PASSWORD=replace-me
APP_SECRET=replace-me-64-hex
TWO_FACTOR_ENCRYPTION_KEY=replace-me-64-hex
