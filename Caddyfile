# KF-Maniacs download site — replace Cloudflare Pages.
# Install: see README.md / deploy.sh
#
# Env overrides (optional, baked by deploy.sh):
#   SITE_ROOT / SITE_DOMAIN / SITE_LOG / CADDY_EMAIL / SITE_IP

{
	email {$CADDY_EMAIL:admin@manul.lol}
}

(site) {
	root * {$SITE_ROOT:/var/www/kfm.manul.lol}
	encode gzip zstd

	handle /api/stats* {
		reverse_proxy 127.0.0.1:{$STATS_PORT:8765}
	}
	handle /statistics* {
		reverse_proxy 127.0.0.1:{$STATS_PORT:8765}
	}

	# Companion installer. stats-server writes a row, then sends the file.
	@companion path_regexp companion (?i)^/(download|KFM-Companion[^/]*\.exe)$
	handle @companion {
		reverse_proxy 127.0.0.1:{$STATS_PORT:8765}
	}

	# Umami tracker, same origin. The app itself listens on 127.0.0.1:9477
	# (site/umami). Only these two paths are public; the dashboard is not.
	handle /kf.js {
		reverse_proxy 127.0.0.1:9477
	}
	handle /api/kf {
		reverse_proxy 127.0.0.1:9477
	}
	handle /umami-website-id {
		header Cache-Control no-store
		header Content-Type text/plain
		file_server
	}

	@blocked {
		path /.env* /Caddyfile* /deploy.sh /fetch-companion.mjs /download-stats.mjs
		path /stats-server.py /statistics.html
		path /.git*
	}
	respond @blocked 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The Vue app owns /players/* and every other page: unknown paths fall
	# back to its index.html (SPA routing).
	handle {
		try_files {path} /index.html
		file_server
	}

	log {
		output file {$SITE_LOG:/var/log/caddy/kfm.manul.lol.log} {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

# kf-maniacs.com is the main address. The old kfm.manul.lol serves the same
# site, not a redirect: old builds and links keep working. Root and log paths
# keep the old name.
kf-maniacs.com, {$SITE_DOMAIN:kfm.manul.lol} {
	import site
}

www.kf-maniacs.com {
	redir https://kf-maniacs.com{uri} permanent
}

# Reachable before DNS is pointed at this VPS (and for health checks).
http://{$SITE_IP:85.192.30.108} {
	import site
}
