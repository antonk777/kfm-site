[Unit]
Description=KF-Maniacs secret statistics API (/statistics/)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/home/kfserver/.kfm-save.env
EnvironmentFile=-/etc/kfm-site.env
WorkingDirectory=/opt/kfm-site
ExecStart=/usr/bin/python3 /opt/kfm-site/stats-server.py
Restart=on-failure
RestartSec=3
User=root
Group=root
Environment=STATS_HOST=127.0.0.1
Environment=STATS_PORT=8765
Environment=STATS_DAYS=180

[Install]
WantedBy=multi-user.target
